{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "windows-msvc",
      "cacheVariables": { "GODOTCPP_TARGET": "template_debug" }
    },
    {
      "name": "windows-msvc-release",
      "inherits": "windows-msvc",
      "cacheVariables": { "GODOTCPP_TARGET": "template_release" }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "cacheVariables": { "GODOTCPP_TARGET": "template_debug" }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "cacheVariables": { "GODOTCPP_TARGET": "template_release" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ]
}
